{
  "name": "ai-data-analyst",
  "version": "0.1.0",
  "description": "Ask a question about a table in plain English. The model writes the query; the browser computes the answer — no backend, and the rows never leave the tab.",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praffulkr94/ai-data-analyst.git"
  },
  "keywords": [
    "llm",
    "anthropic",
    "claude",
    "tool-use",
    "data-visualization",
    "csv",
    "web-worker",
    "react",
    "typescript",
    "d3",
    "zod",
    "natural-language-query"
  ],
  "author": "praffulkr94",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/praffulkr94/ai-data-analyst/issues"
  },
  "homepage": "https://ai-data-analyst-lake.vercel.app/",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project engine --project workspace",
    "test:watch": "vitest",
    "test:browser": "vitest run --project browser",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:all": "vitest run",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:gif": "node scripts/demo-gif.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-quadtree": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "lucide-react": "^1.34.0",
    "papaparse": "^5.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=22"
  }
}
